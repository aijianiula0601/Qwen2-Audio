# SSH Config for Qwen2-Audio Multi-Node Training
# 配置用于多节点训练的SSH设置

# 主节点 202.168.100.178
Host v100_f178
    HostName 202.168.100.178
    User huangjiahong.dracu
    Port 10020
    StrictHostKeyChecking no
    UserKnownHostsFile /dev/null
    ServerAliveInterval 60
    ServerAliveCountMax 3

# 节点 202.168.100.251
Host v100
    HostName 202.168.100.251
    User huangjiahong.dracu
    Port 10020
    StrictHostKeyChecking no
    UserKnownHostsFile /dev/null
    ServerAliveInterval 60
    ServerAliveCountMax 3

# 节点 202.168.100.165
Host v100_f165
    HostName 202.168.100.165
